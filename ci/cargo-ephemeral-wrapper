#!/usr/bin/env bash
set -uo pipefail

real_cargo="${EPHEMERAL_CARGO_REAL_CARGO:-/usr/local/libexec/cargo-ephemeral-bin}"
scratch_base="${EPHEMERAL_CARGO_TMPDIR:-${TMPDIR:-/tmp}/cargo-ephemeral-registry}"

cargo_args=("$@")
if (( ${#cargo_args[@]} )) && [[ "${cargo_args[0]}" == +* ]]; then
    export RUSTUP_TOOLCHAIN="${cargo_args[0]#+}"
    cargo_args=("${cargo_args[@]:1}")
fi

# Keep external subcommands (for example cargo-clippy) inside the wrapper when
# they call back through the standard CARGO environment variable.
export EPHEMERAL_CARGO_WRAPPER="${EPHEMERAL_CARGO_WRAPPER_PATH:-$(readlink -f "$0")}"
export CARGO="$EPHEMERAL_CARGO_WRAPPER"
source_slot="$scratch_base/uid-$(id -u)"
source_root="$source_slot/src"
lock_path="$source_slot/.active.lock"
last_used="$source_slot/.last-used"
prune_checked="$source_slot/.prune-checked"

mkdir -p -- "$source_slot"
exec 8>"$lock_path"

source_pool_bytes() {
    [[ -d "$source_root" ]] || {
        printf '0\n'
        return
    }
    du -s -B1 "$source_root" 2>/dev/null | awk '{print $1+0}'
}

prune_source_pool() {
    local max="${EPHEMERAL_CARGO_SOURCE_MAX_BYTES:-1073741824}"
    local idle="${EPHEMERAL_CARGO_SOURCE_MAX_IDLE_SECONDS:-21600}"
    local interval="${EPHEMERAL_CARGO_SOURCE_PRUNE_INTERVAL_SECONDS:-300}"
    local bytes now last checked age

    now="$(date +%s)"
    checked=0
    if [[ -e "$prune_checked" ]]; then
        checked="$(stat -c %Y "$prune_checked" 2>/dev/null || echo 0)"
    fi
    if (( checked > 0 && interval > 0 && now - checked < interval )); then
        return
    fi

    bytes="$(source_pool_bytes)"
    last=0
    if [[ -e "$last_used" ]]; then
        last="$(stat -c %Y "$last_used" 2>/dev/null || echo 0)"
    elif [[ -d "$source_root" ]]; then
        last="$(stat -c %Y "$source_root" 2>/dev/null || echo 0)"
    fi
    age=$(( now - last ))

    if (( bytes > max )) || (( last > 0 && idle > 0 && age > idle )); then
        rm -rf -- "$source_root"
    fi
    mkdir -p -- "$source_root"
    touch "$prune_checked" 2>/dev/null || true
}

# Reclaim only while no other Cargo uses the stable source pool. Normal
# concurrent invocations share the pool under a shared lock.
if flock -n -x 8; then
    prune_source_pool
    flock -u 8
fi
flock -s 8
mkdir -p -- "$source_root"

export EPHEMERAL_CARGO_REGISTRY_SRC="$source_root"

cleanup() {
    rc=$?
    touch "$last_used" 2>/dev/null || true
    flock -u 8 2>/dev/null || true
    if flock -n -x 8; then
        prune_source_pool
        touch "$last_used" 2>/dev/null || true
        flock -u 8 2>/dev/null || true
    fi
    exit "$rc"
}
trap cleanup EXIT HUP INT TERM

"$real_cargo" "${cargo_args[@]}"
